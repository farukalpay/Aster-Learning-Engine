material material.grid_operator_blue {
  schema_version: 1
  name: "Aster Grid Operator Blue"
  shading_model: LitPBR
  surface_profile: resin
  blend_mode: Opaque
  cull_mode: Back
  receives_decals: false
  receives_shadows: true

  textures {
    albedo: "../textures/grid_lab_albedo.ktx2"
    normal: "../textures/grid_lab_normal.ktx2"
    orm: "../textures/grid_lab_orm.ktx2"
  }

  params {
    base_color_r: 0.08
    base_color_g: 0.24
    base_color_b: 0.62
    emission_r: 0.16
    emission_g: 0.58
    emission_b: 1.00
    emission_strength: 1.65
    roughness: 0.28
    metallic: 0.10
    coat_strength: 0.32
    coat_roughness: 0.12
    triplanar_scale: 3.2
    detail_strength: 0.30
    micro_normal_strength: 0.22
    roughness_variation: 0.14
    height_normal_coupling: 0.42
    roughness_height_coupling: 0.36
    macro_frequency_breakup: 0.24
    micro_frequency_breakup: 0.36
    height_shading: 0.10
    pattern_contrast: 0.34
  }

  features {
    triplanar: true
    normal_map: true
    orm_texture: true
    emissive: true
  }
}
