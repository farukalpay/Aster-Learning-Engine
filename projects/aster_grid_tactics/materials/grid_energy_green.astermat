material material.grid_energy_green {
  schema_version: 1
  name: "Aster Grid Energy Green"
  shading_model: Emissive
  surface_profile: emissive-lens
  blend_mode: Blend
  cull_mode: None
  receives_decals: false
  receives_shadows: false

  params {
    base_color_r: 0.05
    base_color_g: 0.18
    base_color_b: 0.09
    emission_r: 0.24
    emission_g: 1.00
    emission_b: 0.48
    emission_strength: 2.45
    opacity: 0.94
    roughness: 0.22
    pattern_depth: 0.06
    pattern_contrast: 0.34
    micro_normal_strength: 0.08
  }

  features {
    emissive: true
    alpha_blend: true
    double_sided: true
  }
}
