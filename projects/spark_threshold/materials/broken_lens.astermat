material material.spark.broken_lens {
  schema_version: 1
  name: "Spark Broken Lens"
  shading_model: Emissive
  blend_mode: Blend
  cull_mode: None
  receives_decals: false
  receives_shadows: false

  params {
    base_color_r: 0.28
    base_color_g: 0.12
    base_color_b: 0.025
    emission_r: 1.00
    emission_g: 0.55
    emission_b: 0.10
    emission_strength: 1.46
    opacity: 0.92
    roughness: 0.20
    metallic: 0.0
  }

  features {
    alpha: true
    disable_fog: false
  }
}
