{
  "schema_version": 1,
  "id": "scene.cave_entry",
  "name": "Cave Entry",
  "entities": [
    {
      "id": "player_spawn",
      "name": "Player Spawn",
      "components": {
        "transform": { "translation": [1.1, 0.28, 1.0], "rotation": [0.0, 3.14159, 0.0] },
        "camera": { "primary": true, "vertical_fov_degrees": 54.0, "near_plane": 0.01, "far_plane": 160.0 },
        "collider": { "shape": "capsule", "radius": 0.35, "height": 1.10, "layer": "actor.player", "mask": "world.static" },
        "rigid_body": { "type": "dynamic", "mass": 1.0, "linear_damping": 0.045, "angular_damping": 0.35, "gravity_enabled": true, "ccd_enabled": true, "allow_sleep": false, "lock_angular_axes": [1.0, 0.0, 1.0], "solver_iterations": 8 },
        "spawn_point": {
          "spawn_kind": "player",
          "radius": 0.35,
          "half_extents": [0.35, 0.55, 0.35]
        },
        "cave_debug": { "layers": ["spawn_volume"], "color": [0.40, 1.0, 0.42] }
      }
    },
    {
      "id": "supply_chest",
      "name": "Supply Chest",
      "components": {
        "transform": { "translation": [0.0, 0.0, 0.0], "rotation": [0.0, 0.0, 0.0], "scale": [1.0, 1.0, 1.0] },
        "mesh_renderer": { "mesh": "mesh.supply_chest", "material": "material.cave_rock" },
        "perceptual_binding": { "template": "asset_graph.material_lab.wet_rock", "cell_anchor": "cave_entry.main_cell", "residency_role": "interactable-container", "local_cause": "player-loot-route", "traversal_role": "cover-adjacent", "visual_occlusion_role": "grounded-prop", "acoustic_role": "wood-stone-contact", "material_half_life_override": 18.0, "streaming_cost_override": 0.24 },
        "collider": { "shape": "box", "half_extents": [0.55, 0.42, 0.38], "layer": "world.interactable" },
        "rigid_body": { "type": "static", "mass": 0.0, "gravity_enabled": false },
        "interactable": {
          "tags": ["lumen.container.supply", "interaction.openable"],
          "action_graph": "action.chest.open",
          "prompt_action": "Open",
          "prompt_subject": "Supply Chest",
          "radius": 0.82,
          "max_distance": 14.0
        },
        "cave_debug": { "layers": ["collision", "interactable"], "color": [1.0, 0.78, 0.22] },
        "inventory": {
          "slot_count": 3,
          "slots": [
            { "item": "item.torch", "quantity": 1 },
            { "item": "item.pickaxe", "quantity": 1 }
          ]
        }
      }
    },
    {
      "id": "entry_torch",
      "name": "Entry Torch",
      "components": {
        "transform": { "translation": [2.4, 1.1, -1.5] },
        "mesh_renderer": { "mesh": "mesh.torch_wall", "material": "material.torch_flame" },
        "perceptual_binding": { "template": "asset_graph.material_lab.wet_decal_soot", "cell_anchor": "cave_entry.lit_wall", "residency_role": "fixture-light", "local_cause": "player-readable-safe-light", "traversal_role": "wall-mounted", "visual_occlusion_role": "light-source-contact", "acoustic_role": "metal-bracket-wall", "material_half_life_override": 10.0, "streaming_cost_override": 0.18 },
        "light": { "kind": "point", "color": [1.0, 0.42, 0.16], "intensity": 7.4, "radius": 1.08 },
        "torch_socket": { "color": [1.0, 0.42, 0.16], "intensity": 7.4, "radius": 1.08 },
        "cave_debug": { "layers": ["lighting"], "color": [1.0, 0.5, 0.2] }
      }
    },
    {
      "id": "coal_ore_entry",
      "name": "Coal Ore",
      "components": {
        "transform": { "translation": [4.0, 0.65, -3.2] },
        "mesh_renderer": { "mesh": "mesh.coal_ore", "material": "material.cave_rock" },
        "perceptual_binding": { "template": "asset_graph.material_lab.wet_rock", "cell_anchor": "cave_entry.ore_wall", "residency_role": "mineable-resource", "local_cause": "coal-vein-affordance", "traversal_role": "resource-target", "visual_occlusion_role": "embedded-rock", "acoustic_role": "stone-impact", "material_half_life_override": 22.0, "streaming_cost_override": 0.26 },
        "collider": { "shape": "sphere", "radius": 0.28, "layer": "world.mineable" },
        "rigid_body": { "type": "static", "mass": 0.0, "gravity_enabled": false },
        "interactable": {
          "tags": ["resource.coal", "interaction.mineable"],
          "action_graph": "action.mine.coal_ore",
          "prompt_action": "Mine",
          "prompt_subject": "Coal Ore",
          "radius": 0.35,
          "max_distance": 14.0
        },
        "ore_node": { "resource_item": "item.coal", "health": 3, "yield_quantity": 2, "radius": 0.28 },
        "mining": { "resource_item": "item.coal", "health": 3, "yield_quantity": 2, "radius": 0.35 },
        "cave_debug": { "layers": ["mining_target", "collision", "interactable"], "color": [0.86, 0.45, 0.16] }
      }
    },
    {
      "id": "construction_forklift",
      "name": "Construction Forklift",
      "prefab": "prefab.lumen_run.construction_forklift",
      "components": {
        "transform": { "translation": [33.4, 0.02, -54.8], "rotation": [0.0, 1.5708, 0.0] },
        "mesh_renderer": { "mesh": "asset_graph.lumen_run.construction_forklift", "material": "material.lumen_run.forklift_paint" },
        "perceptual_binding": { "template": "asset_graph.lumen_run.construction_forklift", "cell_anchor": "lumen.construction_yard", "residency_role": "drivable-work-vehicle", "local_cause": "player-loads-pipe-pallet", "traversal_role": "vehicle-seat-and-forks", "visual_occlusion_role": "grounded-yard-prop", "acoustic_role": "rubber-metal-contact", "material_half_life_override": 26.0, "streaming_cost_override": 0.34 },
        "collider": { "shape": "box", "half_extents": [0.72, 0.82, 1.72], "layer": "world.vehicle" },
        "rigid_body": { "type": "kinematic", "mass": 900.0, "gravity_enabled": false },
        "interactable": { "tags": ["construction.vehicle.forklift"], "action_graph": "action.construction.forklift.toggle", "prompt_action": "Enter", "prompt_subject": "Forklift", "radius": 1.05, "max_distance": 14.0 },
        "cave_debug": { "layers": ["collision", "interactable"], "color": [1.0, 0.56, 0.18] }
      }
    },
    {
      "id": "construction_pipe_pallet",
      "name": "Pipe Pallet",
      "prefab": "prefab.lumen_run.construction_pipe_pallet",
      "components": {
        "transform": { "translation": [35.2, 0.0, -54.8], "rotation": [0.0, 1.5708, 0.0] },
        "mesh_renderer": { "mesh": "asset_graph.lumen_run.pipe_pallet", "material": "material.lumen_run.rusted_pipe_pallet" },
        "perceptual_binding": { "template": "asset_graph.lumen_run.pipe_pallet", "cell_anchor": "lumen.construction_yard", "residency_role": "forklift-cargo", "local_cause": "pipe-pallet-load-target", "traversal_role": "fork-pocket-cargo", "visual_occlusion_role": "stacked-hollow-pipes", "acoustic_role": "rusted-pipe-clatter", "material_half_life_override": 34.0, "streaming_cost_override": 0.30 },
        "collider": { "shape": "box", "half_extents": [0.72, 0.42, 1.38], "layer": "world.cargo" },
        "rigid_body": { "type": "kinematic", "mass": 180.0, "gravity_enabled": false },
        "interactable": { "tags": ["construction.cargo.pipe_pallet"], "action_graph": "action.construction.pallet.attach", "prompt_action": "Lift", "prompt_subject": "Pipe Pallet", "radius": 0.92, "max_distance": 14.0 },
        "cave_debug": { "layers": ["collision", "interactable"], "color": [0.86, 0.42, 0.16] }
      }
    },
    {
      "id": "recycler_shredder",
      "name": "Recycler Shredder",
      "prefab": "prefab.lumen_run.recycler_shredder",
      "components": {
        "transform": { "translation": [38.6, 0.0, -54.8], "rotation": [0.0, 1.5708, 0.0] },
        "mesh_renderer": { "mesh": "asset_graph.lumen_run.recycler_shredder", "material": "material.lumen_run.shredder_blue_metal" },
        "perceptual_binding": { "template": "asset_graph.lumen_run.recycler_shredder", "cell_anchor": "lumen.construction_yard", "residency_role": "destruction-machine", "local_cause": "pipe-pallet-shredding", "traversal_role": "hazard-intake-output", "visual_occlusion_role": "blue-industrial-machine", "acoustic_role": "metal-shredder", "material_half_life_override": 30.0, "streaming_cost_override": 0.36 },
        "collider": { "shape": "box", "half_extents": [0.90, 0.74, 1.58], "layer": "world.machine" },
        "rigid_body": { "type": "static", "mass": 0.0, "gravity_enabled": false },
        "interactable": { "tags": ["construction.machine.recycler_shredder"], "action_graph": "action.construction.shredder.feed", "prompt_action": "Feed", "prompt_subject": "Recycler", "radius": 1.05, "max_distance": 14.0 },
        "cave_debug": { "layers": ["collision", "interactable"], "color": [0.12, 0.36, 0.82] }
      }
    }
  ]
}
