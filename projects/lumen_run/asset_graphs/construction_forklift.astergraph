node material.steel material_assignment role=material slot=forklift.steel surface_profile=scuffed-steel
node collision.proxy collision_proxy role=collision shape=kinematic-forklift-footprint triangles=96
node lod.chain lod_generator role=lod policy=lod0-lod1 levels=2
node gameplay.mount prefab_variant role=prefab variant=enter-exit-drivable-forklift
node claim.silhouette visual_brief_claim role=quality signal=forklift_silhouette
node claim.forks visual_brief_claim role=quality signal=forks_mast_wheels
node claim.tires visual_brief_claim role=quality signal=treaded_rubber_tires_with_steel_rims
