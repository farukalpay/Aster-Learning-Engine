node reject.raw visual_brief_rejection role=quality signal=raw_glb_fbx_runtime_dependency
node perception.template world_perceptual_template role=perceptual profile=weathered-construction-vehicle surface_response=forklift-painted-metal history_response=vehicle-contact-material-memory material_half_life_seconds=26 wetness_half_life_seconds=12 semantic_lod=0.82 streaming_cost=0.34 patch_channels=paint_wear,rubber_contact,material_stability contact_channels=vehicle_mount,visual_occlusion,traversal_affordance residue_channels=oil_dust,acoustic_contact,player_readable_cause
node export.runtime cook_export role=package target=assetgraphbin
node diagnostic.quality diagnostic role=quality profile=production
