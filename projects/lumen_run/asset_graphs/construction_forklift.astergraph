base_color 0.86 0.45 0.13
roughness 0.54
metallic 0.36
param physical_texel_density 768
param height_normal_coupling 0.58
param roughness_height_coupling 0.54
param macro_frequency_breakup 0.38
param micro_frequency_breakup 0.42
feature normal_map true
preview environment lumen-construction-yard
preview rig forklift-three-quarter
preview artifact /tmp/lumen_run_construction_yard.ppm
node mesh.forklift mesh_primitive role=mesh primitive=construction-forklift body_length=2.95 body_width=1.16 mast_height=2.25
node uv.forklift uv_policy role=uv mapping=packed-low-poly-yard texel_density=768
node tangent.validate tangent_validation role=tangent policy=validate-or-generate
