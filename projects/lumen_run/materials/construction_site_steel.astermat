material material.lumen_run.construction_site_steel {
  schema_version: 1
  name: "Demolition Site Rusted Structural Steel"
  shading_model: Unlit
  blend_mode: Opaque
  cull_mode: Back
  receives_decals: true
  receives_shadows: true
  params {
    base_color_r: 0.38
    base_color_g: 0.31
    base_color_b: 0.24
    roughness: 0.62
    metallic: 0.64
    edge_wear: 0.58
    ambient_occlusion: 0.84
    macro_variation: 0.42
    micro_normal_strength: 0.30
    roughness_variation: 0.30
    height_shading: 0.14
  }
  features {
    procedural_surface: true
    contact_shadows: true
    fracture_marks: true
  }
}
