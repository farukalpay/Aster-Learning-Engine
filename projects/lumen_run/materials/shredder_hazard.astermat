material material.lumen_run.shredder_hazard {
  schema_version: 1
  name: "Recycler Shredder Hazard Paint"
  shading_model: Unlit
  blend_mode: Opaque
  cull_mode: Back
  receives_decals: true
  receives_shadows: true

  params {
    base_color_r: 0.94
    base_color_g: 0.70
    base_color_b: 0.12
    roughness: 0.48
    metallic: 0.18
    edge_wear: 0.34
    ambient_occlusion: 0.88
    macro_variation: 0.34
    micro_normal_strength: 0.18
    roughness_variation: 0.22
    height_shading: 0.08
  }

  features {
    procedural_surface: true
    contact_shadows: true
  }
}
