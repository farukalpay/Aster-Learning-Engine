material material.lumen_run.crane_yellow {
  schema_version: 1
  name: "Mobile Crane Weathered Yellow Paint"
  shading_model: Unlit
  blend_mode: Opaque
  cull_mode: Back
  receives_decals: true
  receives_shadows: true
  params {
    base_color_r: 0.82
    base_color_g: 0.53
    base_color_b: 0.10
    roughness: 0.54
    metallic: 0.50
    edge_wear: 0.54
    ambient_occlusion: 0.80
    macro_variation: 0.34
    micro_normal_strength: 0.25
    roughness_variation: 0.26
    height_shading: 0.10
  }
  features {
    procedural_surface: true
    contact_shadows: true
    hazard_decal_receiver: true
  }
}
