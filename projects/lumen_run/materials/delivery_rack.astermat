material material.lumen_run.delivery_rack {
  schema_version: 1
  name: "Marked Bale Delivery Rack"
  shading_model: Unlit
  blend_mode: Opaque
  cull_mode: Back
  receives_decals: true
  receives_shadows: true
  params {
    base_color_r: 0.30
    base_color_g: 0.32
    base_color_b: 0.34
    roughness: 0.62
    metallic: 0.65
    edge_wear: 0.48
    ambient_occlusion: 0.86
    macro_variation: 0.28
    micro_normal_strength: 0.20
    roughness_variation: 0.20
    height_shading: 0.08
  }
  features {
    procedural_surface: true
    contact_shadows: true
    hazard_decal_receiver: true
  }
}
