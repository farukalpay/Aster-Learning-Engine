{
  "schema_version": 1,
  "id": "action.construction.shredder.feed",
  "name": "Feed Visible Cutter Shredder",
  "nodes": [
    {
      "id": "feed_shredder",
      "type": "emit_event",
      "parameters": {
        "event": "construction.shredder.feed_metal_load",
        "shredder": "target"
      },
      "tags": ["interaction.vehicle", "construction_yard", "destruction_sequence"]
    },
    {
      "id": "emit_scrap",
      "type": "spawn_effect",
      "parameters": {
        "effect": "visible_cutter_sparks_dust_scrap_output",
        "asset": "asset_graph.lumen_run.shredded_metal_scrap"
      }
    }
  ]
}
