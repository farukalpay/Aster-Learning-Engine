{
  "schema_version": 1,
  "id": "action.mine.coal_ore",
  "name": "Mine Coal Ore",
  "nodes": [
    {
      "id": "request_mining_attempt",
      "type": "mining_attempt",
      "parameters": {
        "required_tag": "tool.mining",
        "resource_item": "item.coal",
        "target": "target"
      },
      "tags": ["interaction.mineable", "resource.coal"]
    }
  ],
  "reaction_contracts": [
    {
      "id": "coal_mining_reaction",
      "minimum_score": 0.68,
      "required_channels": [
        "material_memory",
        "event_residue",
        "sensory_feedback",
        "resource_state",
        "ai_attention",
        "ui_feedback"
      ],
      "required_events": [
        "surface_hit",
        "crack",
        "shard_burst",
        "dust_burst",
        "carve_resource_state_write",
        "ai_noise_attention",
        "ui_feedback"
      ]
    }
  ]
}
