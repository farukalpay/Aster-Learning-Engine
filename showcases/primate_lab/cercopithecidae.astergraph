node anatomy.maxilla anatomy_landmark role=landmark label="prognathic maxilla" prognathism=0.29
node anatomy.mandible sweep_limb role=bone label="mandibular ramus" height=0.20
node anatomy.sutures suture_curve role=bone label="cranial suture curves" count=4 relief=0.012
node anatomy.zygoma_arch sweep_limb role=bone label="zygomatic arch span" span=0.74
node anatomy.dentition bilophodont_tooth_row role=dentition molars=8 loph_pairs=16 cusps=32
node anatomy.orbit surface_pad role=soft_tissue label="periocular organization"
node anatomy.temporalis muscle_volume role=muscle label="temporalis insertio"
node anatomy.zygoma tendon_band role=tendon label="zygomaticus major minor"
node anatomy.axial sweep_limb role=skeleton cervical=7 thoracic=12 lumbar=7
node anatomy.ribs rib_cage role=skeleton rib_pairs=12 sternum=true
node anatomy.forelimb sweep_limb role=appendicular label="radius ulna pronation supination"
