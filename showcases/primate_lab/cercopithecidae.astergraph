node integument.hypodermis hypodermal_vascular_field role=integument vascularity=0.49 translucency=0.42
node integument.follicles follicle_distribution role=surface guides=117 anisotropy=dorsal-caudal density=1.22
node integument.pigment pigment_mask role=material melanin_heterogeneity=0.68 uv_dispersion=0.24
node integument.glands gland_cluster role=surface count=36 nazolabial=true axillary=true
node integument.capillary capillary_translucency role=material periorbital=0.58 rhinarium=0.63 auricular=0.46
node integument.tension surface_tension_line role=geometry count=6 orbicularis_oris=true masseter=true frontalis=true
node integument.abrasion micro_abrasion role=material density=0.50 dust=0.12 uv_scatter=0.20
node anatomy.surface_detail surface_displacement role=geometry amplitude=0.010 frequency=12 ridge=0.82
