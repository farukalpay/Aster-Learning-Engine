astergraph asset_graph.pipe_lab.rusted_pipe
schema_version 1
name "Rusted Pipe Production Runtime Asset"
material_id material.graph_rusted_pipe
surface_profile corroded-metal
primitive rusted-pipe
uv_policy pipe-triplanar-uv-islands
tangent_policy validate-or-generate
collision_proxy pipe-runtime-bounds
lod_policy lod0-lod1-lod2
base_color 0.30 0.135 0.06
roughness 0.72
metallic 0.48
param wetness 0.18
param macro_variation 0.90
param micro_normal_strength 0.46
param roughness_variation 0.92
param physical_texel_density 1024
param height_normal_coupling 0.92
param roughness_height_coupling 0.74
param macro_frequency_breakup 0.48
param micro_frequency_breakup 0.66
param height_shading 0.36
param detail_scale 12.40
param detail_strength 1.02
param rust_strength 0.98
param seam_grime 0.64
param exposed_edge_ratio 0.22
param pitting_density 0.96
param pitting_depth 0.0055
param oxide_layering 0.92
param cavity_grime 0.84
param edge_polish 0.36
param weld_heat_tint 0.48
param axial_scratches 0.82
param rust_bloom 0.92
param black_scab 0.78
param paint_remnant 0.06
param weld_slag 0.88
param rim_soot 0.92
param attachment_clearance 0.0065
param weld_contact_skirt_width 0.040
param seam_inset_depth 0.004
param rim_normal_feather 0.78
param wet_streaks 7
feature triplanar true
feature normal_map true
feature parallax true
preview environment inspection-neutral
preview rig pipe-lab-three-quarter
preview artifact industrial_pipe.png
